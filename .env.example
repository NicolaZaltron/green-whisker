# ==============================================================================
# Green Whisker - Configurazione Ambiente & AI Importer
# ==============================================================================

# Provider AI selezionato: 'gemini' (predefinito), 'openai', 'claude', 'openrouter', 'custom'
EXPO_PUBLIC_AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini (Consigliato - Free tier su https://aistudio.google.com/)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
# Modello opzionale (default: gemini-2.5-flash o gemini-1.5-flash)
# EXPO_PUBLIC_AI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. OpenAI
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_AI_PROVIDER=openai
# EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
# EXPO_PUBLIC_AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Anthropic Claude
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_AI_PROVIDER=claude
# EXPO_PUBLIC_CLAUDE_API_KEY=your_claude_api_key_here
# EXPO_PUBLIC_AI_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 4. OpenRouter
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_AI_PROVIDER=openrouter
# EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
# EXPO_PUBLIC_AI_MODEL=deepseek/deepseek-chat

# ------------------------------------------------------------------------------
# 5. Modelli Locali / Custom (Ollama, LM Studio, LocalAI)
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_AI_PROVIDER=custom
# EXPO_PUBLIC_AI_BASE_URL=http://localhost:11434/v1
# EXPO_PUBLIC_AI_MODEL=llama3.2
# EXPO_PUBLIC_AI_API_KEY=optional_token
